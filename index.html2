<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Shrimp Farm Manager</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #eef7fa;
    color: #17323a;
}

/* HEADER */
header {
    background: linear-gradient(135deg, #006d77, #023e8a);
    color: white;
    padding: 25px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 25px;
    font-weight: bold;
}

header span {
    font-size: 14px;
    opacity: .9;
}

/* NAVIGATION */
nav {
    background: white;
    padding: 15px 7%;
    box-shadow: 0 2px 8px rgba(0,0,0,.1);
    position: sticky;
    top: 0;
    z-index: 10;
}

nav a {
    text-decoration: none;
    color: #006d77;
    font-weight: bold;
    margin-right: 22px;
}

nav a:hover {
    color: #023e8a;
}

/* HERO */
.hero {
    padding: 70px 7%;
    background: linear-gradient(
        rgba(0,109,119,.88),
        rgba(2,62,138,.88)
    );
    color: white;
}

.hero h1 {
    font-size: 48px;
    margin-bottom: 15px;
}

.hero p {
    font-size: 19px;
    max-width: 700px;
}

/* SECTIONS */
section {
    padding: 45px 7%;
}

section h2 {
    color: #006d77;
    margin-bottom: 25px;
    font-size: 30px;
}

/* DASHBOARD */
.dashboard {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px,1fr));
    gap: 20px;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 14px;
    box-shadow: 0 3px 12px rgba(0,0,0,.08);
}

.card h3 {
    color: #006d77;
    margin-bottom: 10px;
}

.number {
    font-size: 30px;
    font-weight: bold;
    color: #023e8a;
}

/* FORMS */
.form-box {
    background: white;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 3px 12px rgba(0,0,0,.08);
    margin-bottom: 30px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px,1fr));
    gap: 18px;
}

label {
    font-weight: bold;
    display: block;
    margin-bottom: 6px;
}

input, select, textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccdfe3;
    border-radius: 8px;
    outline: none;
}

input:focus,
select:focus,
textarea:focus {
    border-color: #006d77;
}

button {
    margin-top: 20px;
    padding: 13px 25px;
    border: none;
    border-radius: 8px;
    background: #006d77;
    color: white;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #023e8a;
}

/* TABLE */
.table-box {
    overflow-x: auto;
    background: white;
    border-radius: 15px;
    box-shadow: 0 3px 12px rgba(0,0,0,.08);
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 700px;
}

th, td {
    padding: 14px;
    text-align: left;
    border-bottom: 1px solid #e5eeee;
}

th {
    background: #006d77;
    color: white;
}

.delete-btn {
    background: #c1121f;
    margin: 0;
    padding: 7px 12px;
}

/* FOOTER */
footer {
    background: #023e8a;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 30px;
}

/* MOBILE */
@media(max-width:600px) {

    .hero h1 {
        font-size: 35px;
    }

    header {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }

    nav a {
        display: inline-block;
        margin-bottom: 8px;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">🦐 SHRIMP FARM MANAGER</div>
    <span>Farm Management System</span>
</header>

<nav>
    <a href="#dashboard">Dashboard</a>
    <a href="#farm">Farm</a>
    <a href="#feed">Feed</a>
    <a href="#medicine">Products</a>
    <a href="#water">Water</a>
    <a href="#expenses">Expenses</a>
</nav>

<!-- HERO -->
<div class="hero">
    <h1>Smart Shrimp Farming</h1>
    <p>
        Manage your ponds, feed, aqua products,
        water quality, expenses and farm records
        from one place.
    </p>
</div>

<!-- DASHBOARD -->
<section id="dashboard">

<h2>📊 Farm Dashboard</h2>

<div class="dashboard">

    <div class="card">
        <h3>Total Feed Bought</h3>
        <div class="number" id="totalFeedBought">0 kg</div>
    </div>

    <div class="card">
        <h3>Total Feed Used</h3>
        <div class="number" id="totalFeedUsed">0 kg</div>
    </div>

    <div class="card">
        <h3>Feed Remaining</h3>
        <div class="number" id="feedRemaining">0 kg</div>
    </div>

    <div class="card">
        <h3>Product Cost</h3>
        <div class="number" id="productCost">₹0</div>
    </div>

    <div class="card">
        <h3>Total Expenses</h3>
        <div class="number" id="totalExpenses">₹0</div>
    </div>

</div>

</section>

<!-- FARM DETAILS -->
<section id="farm">

<h2>🏞️ Farm / Pond Details</h2>

<div class="form-box">

<div class="form-grid">

<div>
<label>Farm Name</label>
<input type="text" id="farmName" placeholder="Example: Sri Aqua Farm">
</div>

<div>
<label>Pond Number</label>
<input type="text" id="pondNumber" placeholder="Example: Pond 1">
</div>

<div>
<label>Pond Size (acres)</label>
<input type="number" id="pondSize" placeholder="Example: 2">
</div>

<div>
<label>Stocking Date</label>
<input type="date" id="stockingDate">
</div>

<div>
<label>Seed Quantity</label>
<input type="number" id="seedQuantity" placeholder="Number of shrimp">
</div>

</div>

<button onclick="saveFarm()">Save Farm Details</button>

<p id="farmMessage"></p>

</div>

</section>

<!-- FEED -->
<section id="feed">

<h2>🍤 Feed Management</h2>

<div class="form-box">

<div class="form-grid">

<div>
<label>Date</label>
<input type="date" id="feedDate">
</div>

<div>
<label>Shop / Supplier</label>
<input type="text" id="feedShop" placeholder="Shop name">
</div>

<div>
<label>Feed Brand</label>
<input type="text" id="feedBrand" placeholder="Feed brand">
</div>

<div>
<label>Quantity Bought (kg)</label>
<input type="number" id="feedBought" placeholder="500">
</div>

<div>
<label>Quantity Used (kg)</label>
<input type="number" id="feedUsed" placeholder="25">
</div>

<div>
<label>Feed Cost (₹)</label>
<input type="number" id="feedCost" placeholder="25000">
</div>

</div>

<button onclick="addFeed()">Add Feed Record</button>

</div>

<div class="table-box">

<table>

<thead>
<tr>
<th>Date</th>
<th>Shop</th>
<th>Brand</th>
<th>Bought</th>
<th>Used</th>
<th>Remaining</th>
<th>Cost</th>
<th>Action</th>
</tr>
</thead>

<tbody id="feedTable"></tbody>

</table>

</div>

</section>

<!-- MEDICINE / PRODUCTS -->
<section id="medicine">

<h2>💊 Aqua Products / Medicines</h2>

<div class="form-box">

<div class="form-grid">

<div>
<label>Date</label>
<input type="date" id="productDate">
</div>

<div>
<label>Product Name</label>
<input type="text" id="productName" placeholder="Product name">
</div>

<div>
<label>Shop / Supplier</label>
<input type="text" id="productShop" placeholder="Shop name">
</div>

<div>
<label>Quantity Bought</label>
<input type="number" id="productBought" placeholder="10">
</div>

<div>
<label>Quantity Used</label>
<input type="number" id="productUsed" placeholder="2">
</div>

<div>
<label>Cost (₹)</label>
<input type="number" id="productPrice" placeholder="1500">
</div>

</div>

<button onclick="addProduct()">Add Product Record</button>

</div>

<div class="table-box">

<table>

<thead>
<tr>
<th>Date</th>
<th>Product</th>
<th>Shop</th>
<th>Bought</th>
<th>Used</th>
<th>Remaining</th>
<th>Cost</th>
<th>Action</th>
</tr>
</thead>

<tbody id="productTable"></tbody>

</table>

</div>

</section>

<!-- WATER -->
<section id="water">

<h2>💧 Water Quality</h2>

<div class="form-box">

<div class="form-grid">

<div>
<label>Date</label>
<input type="date" id="waterDate">
</div>

<div>
<label>pH</label>
<input type="number" step="0.01" id="ph" placeholder="8.0">
</div>

<div>
<label>Temperature °C</label>
<input type="number" step="0.1" id="temperature" placeholder="29">
</div>

<div>
<label>Dissolved Oxygen</label>
<input type="number" step="0.01" id="oxygen" placeholder="5">
</div>

<div>
<label>Salinity</label>
<input type="number" step="0.1" id="salinity" placeholder="15">
</div>

<div>
<label>Ammonia</label>
<input type="number" step="0.01" id="ammonia" placeholder="0.1">
</div>

</div>

<button onclick="addWater()">Add Water Record</button>

</div>

<div class="table-box">

<table>

<thead>
<tr>
<th>Date</th>
<th>pH</th>
<th>Temp</th>
<th>DO</th>
<th>Salinity</th>
<th>Ammonia</th>
<th>Action</th>
</tr>
</thead>

<tbody id="waterTable"></tbody>

</table>

</div>

</section>

<!-- EXPENSES -->
<section id="expenses">

<h2>💰 Other Expenses</h2>

<div class="form-box">

<div class="form-grid">

<div>
<label>Date</label>
<input type="date" id="expenseDate">
</div>

<div>
<label>Category</label>

<select id="expenseCategory">
<option>Seed</option>
<option>Feed</option>
<option>Labour</option>
<option>Electricity</option>
<option>Medicine</option>
<option>Transport</option>
<option>Other</option>
</select>

</div>

<div>
<label>Description</label>
<input type="text" id="expenseDescription">
</div>

<div>
<label>Amount (₹)</label>
<input type="number" id="expenseAmount">
</div>

</div>

<button onclick="addExpense()">Add Expense</button>

</div>

<div class="table-box">

<table>

<thead>
<tr>
<th>Date</th>
<th>Category</th>
<th>Description</th>
<th>Amount</th>
<th>Action</th>
</tr>
</thead>

<tbody id="expenseTable"></tbody>

</table>

</div>

</section>

<footer>
    © 2026 Shrimp Farm Manager | Aqua Farming
</footer>


<script>

/* STORAGE */

let feeds = JSON.parse(localStorage.getItem("feeds")) || [];
let products = JSON.parse(localStorage.getItem("products")) || [];
let waters = JSON.parse(localStorage.getItem("waters")) || [];
let expenses = JSON.parse(localStorage.getItem("expenses")) || [];


/* FARM */

function saveFarm() {

    const farm = {
        name: document.getElementById("farmName").value,
        pond: document.getElementById("pondNumber").value,
        size: document.getElementById("pondSize").value,
        stocking: document.getElementById("stockingDate").value,
        seed: document.getElementById("seedQuantity").value
    };

    localStorage.setItem("farm", JSON.stringify(farm));

    document.getElementById("farmMessage").innerText =
        "✅ Farm details saved successfully!";
}


/* FEED */

function addFeed() {

    let bought = Number(document.getElementById("feedBought").value);
    let used = Number(document.getElementById("feedUsed").value);

    if (!bought && !used) {
        alert("Please enter feed quantity.");
        return;
    }

    feeds.push({
        date: document.getElementById("feedDate").value,
        shop: document.getElementById("feedShop").value,
        brand: document.getElementById("feedBrand").value,
        bought: bought,
        used: used,
        cost: Number(document.getElementById("feedCost").value) || 0
    });

    localStorage.setItem("feeds", JSON.stringify(feeds));

    renderFeeds();

    document.getElementById("feedBought").value = "";
    document.getElementById("feedUsed").value = "";
    document.getElementById("feedCost").value = "";
}


function deleteFeed(index) {

    feeds.splice(index,1);

    localStorage.setItem("feeds", JSON.stringify(feeds));

    renderFeeds();
}


function renderFeeds() {

    let html = "";
    let runningBalance = 0;

    feeds.forEach((f,index) => {

        runningBalance += f.bought - f.used;

        html += `
        <tr>
            <td>${f.date}</td>
            <td>${f.shop}</td>
            <td>${f.brand}</td>
            <td>${f.bought} kg</td>
            <td>${f.used} kg</td>
            <td>${runningBalance.toFixed(2)} kg</td>
            <td>₹${f.cost}</td>
            <td>
                <button class="delete-btn"
                onclick="deleteFeed(${index})">Delete</button>
            </td>
        </tr>
        `;
    });

    document.getElementById("feedTable").innerHTML = html;

    updateDashboard();
}


/* PRODUCTS */

function addProduct() {

    let bought = Number(document.getElementById("productBought").value);
    let used = Number(document.getElementById("productUsed").value);

    products.push({

        date: document.getElementById("productDate").value,

        name: document.getElementById("productName").value,

        shop: document.getElementById("productShop").value,

        bought: bought,

        used: used,

        price: Number(document.getElementById("productPrice").value) || 0

    });

    localStorage.setItem("products", JSON.stringify(products));

    renderProducts();
}


function deleteProduct(index) {

    products.splice(index,1);

    localStorage.setItem("products", JSON.stringify(products));

    renderProducts();
}


function renderProducts() {

    let html = "";
    let balance = {};

    products.forEach((p,index) => {

        if (!balance[p.name]) balance[p.name] = 0;

        balance[p.name] += p.bought - p.used;

        html += `
        <tr>

        <td>${p.date}</td>

        <td>${p.name}</td>

        <td>${p.shop}</td>

        <td>${p.bought}</td>

        <td>${p.used}</td>

        <td>${balance[p.name]}</td>

        <td>₹${p.price}</td>

        <td>
        <button class="delete-btn"
        onclick="deleteProduct(${index})">
        Delete
        </button>
        </td>

        </tr>
        `;
    });

    document.getElementById("productTable").innerHTML = html;

    updateDashboard();
}


/* WATER */

function addWater() {

    waters.push({

        date: document.getElementById("waterDate").value,

        ph: document.getElementById("ph").value,

        temp: document.getElementById("temperature").value,

        oxygen: document.getElementById("oxygen").value,

        salinity: document.getElementById("salinity").value,

        ammonia: document.getElementById("ammonia").value

    });

    localStorage.setItem("waters", JSON.stringify(waters));

    renderWater();
}


function deleteWater(index) {

    waters.splice(index,1);

    localStorage.setItem("waters", JSON.stringify(waters));

    renderWater();
}


function renderWater() {

    let html = "";

    waters.forEach((w,index) => {

        html += `
        <tr>

        <td>${w.date}</td>

        <td>${w.ph}</td>

        <td>${w.temp} °C</td>

        <td>${w.oxygen}</td>

        <td>${w.salinity}</td>

        <td>${w.ammonia}</td>

        <td>
        <button class="delete-btn"
        onclick="deleteWater(${index})">
        Delete
        </button>
        </td>

        </tr>
        `;
    });

    document.getElementById("waterTable").innerHTML = html;
}


/* EXPENSES */

function addExpense() {

    expenses.push({

        date: document.getElementById("expenseDate").value,

        category: document.getElementById("expenseCategory").value,

        description:
        document.getElementById("expenseDescription").value,

        amount:
        Number(document.getElementById("expenseAmount").value) || 0

    });

    localStorage.setItem("expenses", JSON.stringify(expenses));

    renderExpenses();
}


function deleteExpense(index) {

    expenses.splice(index,1);

    localStorage.setItem("expenses", JSON.stringify(expenses));

    renderExpenses();
}


function renderExpenses() {

    let html = "";

    expenses.forEach((e,index) => {

        html += `
        <tr>

        <td>${e.date}</td>

        <td>${e.category}</td>

        <td>${e.description}</td>

        <td>₹${e.amount}</td>

        <td>

        <button class="delete-btn"
        onclick="deleteExpense(${index})">

        Delete

        </button>

        </td>

        </tr>
        `;
    });

    document.getElementById("expenseTable").innerHTML = html;

    updateDashboard();
}


/* DASHBOARD */

function updateDashboard() {

    let bought = feeds.reduce(
        (sum,f) => sum + f.bought,0
    );

    let used = feeds.reduce(
        (sum,f) => sum + f.used,0
    );

    let productCost = products.reduce(
        (sum,p) => sum + p.price,0
    );

    let expenseTotal = expenses.reduce(
        (sum,e) => sum + e.amount,0
    );

    document.getElementById("totalFeedBought")
        .innerText = bought.toFixed(2) + " kg";

    document.getElementById("totalFeedUsed")
        .innerText = used.toFixed(2) + " kg";

    document.getElementById("feedRemaining")
        .innerText = (bought-used).toFixed(2) + " kg";

    document.getElementById("productCost")
        .innerText = "₹" + productCost.toFixed(2);

    document.getElementById("totalExpenses")
        .innerText = "₹" +
        (productCost + expenseTotal).toFixed(2);
}


/* LOAD DATA */

renderFeeds();
renderProducts();
renderWater();
renderExpenses();
updateDashboard();

</script>

</body>
</html>
